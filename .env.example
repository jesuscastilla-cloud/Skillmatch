# ============================================================
#  Variables de entorno de SkillMatch
#  Copia este archivo como .env (local) o pega estas variables
#  en el panel de tu hosting (Railway / Render / Fly).
# ============================================================

# --- OBLIGATORIAS ---

# Cadena de conexion de MongoDB Atlas.
# Pegala tal cual te la da Atlas, reemplazando <password> y el nombre de la BD.
# Ojo: si la contrasena tiene @ # ? / : debes codificarla (@ = %40, # = %23).
MONGODB_URI=mongodb+srv://usuario:contrasena@cluster0.xxxxx.mongodb.net/skillmatch?retryWrites=true&w=majority

# Clave para firmar los JWT. MINIMO 32 caracteres.
# Generala con:  openssl rand -base64 48
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria-de-mas-de-32-caracteres

# --- OPCIONALES (tienen valores por defecto sensatos) ---

# Puerto. Railway y Render lo inyectan solos, no hace falta ponerlo.
# PORT=8080

# Duracion del token en milisegundos (86400000 = 24 horas)
# JWT_EXPIRATION=86400000

# Dominios permitidos para llamar a la API desde el navegador.
# Solo hace falta si el frontend esta en OTRO dominio que el backend.
# ALLOWED_ORIGINS=https://mi-sitio.netlify.app,http://localhost:*

# Si el frontend esta en otro dominio y usas la cookie de sesion:
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=None

# Datos de prueba. Ponlo en true UNA vez para poblar una base vacia,
# y vuelvelo a false despues.
# SEED_ENABLED=false
# SEED_USERS=150
# SEED_COMPANIES=40
# SEED_JOBS=120
# SEED_APPLICATIONS=300

# Intentos de login/registro permitidos por IP y por minuto
# RATE_LIMIT_MAX=20
